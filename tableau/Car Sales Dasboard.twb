      </column>
      <column caption='YTD total sales' datatype='integer' default-format='c&quot;$&quot;#,##0,,.00M;-&quot;$&quot;#,##0,,.00M' name='[Calculation_1621489315168258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF &#10;YEAR([Date]) = {MAX(YEAR([Date]))}&#10;THEN&#10;[Price ($)]&#10;END&#10;)' />
      </column>
      <column caption='YOY sales' datatype='real' name='[Calculation_1621489318977540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1621489315168258] - [YTD total sales (copy)_1621489316057091]) / [YTD total sales (copy)_1621489316057091]' />
      </column>
      <column caption='YTD Cars Sold' datatype='integer' default-format='c&quot;#&quot;#,##0,.00K;-&quot;#&quot;#,##0,.00K' name='[Calculation_1621489673134085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF &#10;YEAR([Date]) = {MAX(YEAR([Date]))}&#10;THEN&#10;[Car_id]&#10;END&#10;)' />
      </column>
      <column caption='YoY cars sold growth' datatype='real' default-format='p0.00%' name='[Calculation_1621489674940423]' role='measure' type='quantitative'>
