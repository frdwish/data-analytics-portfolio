      <column caption='PYTD avg price' datatype='real' name='[Calculation_0234868696694785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[YTD total sales (copy)_1621489316057091] / [YTD Cars Sold (copy)_1621489673850886]' />
